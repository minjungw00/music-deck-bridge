{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "current-track-title",
  "controller": "Encoder",
  "items": [
    {
      "key": "title",
      "type": "text",
      "rect": [16, 10, 136, 24],
      "font": { "size": 16, "weight": 600 },
      "alignment": "left"
    },
    {
      "key": "value",
      "type": "text",
      "rect": [16, 40, 168, 32],
      "font": { "size": 18, "weight": 600 },
      "alignment": "left",
      "color": "white",
      "text-overflow": "ellipsis"
    },
    {
      "key": "time",
      "type": "text",
      "rect": [16, 72, 168, 16],
      "font": { "size": 12 },
      "alignment": "left",
      "color": "white"
    }
  ]
}
