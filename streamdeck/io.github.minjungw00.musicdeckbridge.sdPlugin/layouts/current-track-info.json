{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "current-track-info",
  "controller": "Encoder",
  "items": [
    {
      "key": "icon",
      "type": "pixmap",
      "rect": [16, 40, 48, 48]
    },
    {
      "key": "title",
      "type": "text",
      "rect": [16, 10, 136, 24],
      "font": { "size": 16, "weight": 600 },
      "alignment": "left"
    },
    {
      "key": "value",
      "type": "text",
      "rect": [76, 40, 108, 32],
      "font": { "size": 18, "weight": 600 },
      "alignment": "right",
      "color": "white",
      "text-overflow": "ellipsis"
    },
    {
      "key": "time",
      "type": "text",
      "rect": [76, 72, 108, 16],
      "font": { "size": 12 },
      "alignment": "right",
      "color": "white"
    }
  ]
}
