{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Actions": [
    {
      "Name": "Now Playing",
      "UUID": "io.github.minjungw00.musicdeckbridge.nowplaying",
      "Icon": "imgs/actions/nowplaying/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/nowplaying/key",
          "TitleAlignment": "bottom",
          "FontSize": 10,
          "ShowTitle": true
        }
      ],
      "Tooltip": "Show artwork, song and artist. Press to play/pause or open YouTube Music when closed."
    },
    {
      "Name": "Play / Pause",
      "UUID": "io.github.minjungw00.musicdeckbridge.toggle",
      "Icon": "imgs/actions/toggle/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/toggle/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": false
        }
      ],
      "Tooltip": "Play/pause, or open YouTube Music when no player is open."
    },
    {
      "Name": "Previous Track",
      "UUID": "io.github.minjungw00.musicdeckbridge.prev",
      "Icon": "imgs/actions/prev/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/prev/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": true
        }
      ],
      "Tooltip": "Skip to the previous track."
    },
    {
      "Name": "Next Track",
      "UUID": "io.github.minjungw00.musicdeckbridge.next",
      "Icon": "imgs/actions/next/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/next/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": true
        }
      ],
      "Tooltip": "Skip to the next track."
    },
    {
      "Name": "Mute",
      "UUID": "io.github.minjungw00.musicdeckbridge.mute",
      "Icon": "imgs/actions/mute/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/mute/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": true
        }
      ],
      "Tooltip": "Toggle mute."
    },
    {
      "Name": "Volume Dial",
      "UUID": "io.github.minjungw00.musicdeckbridge.volume",
      "Icon": "imgs/actions/volume/icon",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/volume/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": true
        }
      ],
      "Tooltip": "Turn to adjust volume; push or touch to mute.",
      "Encoder": {
        "Icon": "imgs/actions/volume/key",
        "layout": "$B1",
        "TriggerDescription": {
          "Push": "Mute",
          "Rotate": "Adjust YouTube Music volume",
          "Touch": "Mute"
        }
      }
    },
    {
      "Name": "Current Track Dial",
      "UUID": "io.github.minjungw00.musicdeckbridge.trackdial",
      "Icon": "imgs/actions/toggle/icon",
      "Controllers": [
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/toggle/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": true
        }
      ],
      "Tooltip": "Turn for previous/next track; push or touch to play/pause. Show song info or album artwork.",
      "Encoder": {
        "Icon": "imgs/actions/toggle/key",
        "layout": "$A1",
        "TriggerDescription": {
          "Push": "Play / Pause",
          "Rotate": "Previous / next track",
          "Touch": "Play / Pause"
        }
      }
    },
    {
      "Name": "Open YouTube Music",
      "UUID": "io.github.minjungw00.musicdeckbridge.open",
      "Icon": "imgs/actions/open/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/open/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": false
        }
      ],
      "Tooltip": "Open or focus YouTube Music in Chrome."
    },
    {
      "Name": "Like",
      "UUID": "io.github.minjungw00.musicdeckbridge.like",
      "Icon": "imgs/actions/like/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/like/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": false
        }
      ],
      "Tooltip": "Like the current song; press again to remove the like."
    },
    {
      "Name": "Dislike",
      "UUID": "io.github.minjungw00.musicdeckbridge.dislike",
      "Icon": "imgs/actions/dislike/icon",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/dislike/key",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "ShowTitle": false
        }
      ],
      "Tooltip": "Dislike the current song; press again to remove the dislike."
    }
  ],
  "Author": "minjungw00",
  "Category": "Music Deck Bridge",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "Description": "Control YouTube Music directly from Chrome or its installed app. Independent, unofficial integration.",
  "Icon": "imgs/plugin/icon",
  "Name": "Music Deck Bridge",
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "UUID": "io.github.minjungw00.musicdeckbridge",
  "Version": "1.1.0.0",
  "PropertyInspectorPath": "property-inspector/settings.html"
}
